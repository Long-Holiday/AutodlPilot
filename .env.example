# ==============================================================================
# AutoDL Pilot MCP Server Configuration
# ==============================================================================

# [Required] AutoDL 开发者 Token (从 AutoDL 控制台 -> 设置 -> 开发者Token 获取)
AUTODL_TOKEN=your_autodl_developer_token_here

# [Optional] AutoDL API Host, 默认 https://api.autodl.com
AUTODL_BASE_URL=https://api.autodl.com

# [Required] 保护 MCP 服务的鉴权 Token (本地 Agent 远程连接时需携带: Authorization: Bearer <MCP_AUTH_TOKEN>)
MCP_AUTH_TOKEN=your_secure_mcp_access_token_here

# [Optional] 服务运行端口与主机
PORT=3000
HOST=0.0.0.0

# [Optional] SQLite 数据存储路径 (用于持久化持续开机任务状态及实验记录)
DATABASE_PATH=./data/autodl-pilot.db

# [Optional] 持续开机重试调度参数
RETRY_INITIAL_INTERVAL_SEC=10
RETRY_MAX_INTERVAL_SEC=60
RETRY_BACKOFF_FACTOR=1.5
RETRY_MAX_DURATION_MINUTES=60

# [Optional] 实例开机后状态轮询参数 (直到进入 running 状态)
POLL_STATUS_INTERVAL_SEC=5
POLL_STATUS_TIMEOUT_SEC=180

# [Optional] 日志级别 (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
