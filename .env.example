# AutoDL Pilot：部署服务器项目根目录 .env
# 不提交 .env，不将 AutoDL 开发者 token 交给本机 agent。
AUTODL_TOKEN=your_autodl_developer_token_here
AUTODL_BASE_URL=https://api.autodl.com
AUTODL_TIMEOUT_MS=15000

# 与 AutoDL token 不同；本机 MCP 客户端使用 Authorization: Bearer <MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=your_secure_mcp_access_token_here
# 默认拒绝带 Origin 的浏览器请求；按需填入可信 Origin，逗号分隔，不使用通配符。
MCP_ALLOWED_ORIGINS=

# 默认本机监听，远程接入通过 HTTPS 反向代理或私有隧道。
HOST=127.0.0.1
PORT=3000
# 相对路径从项目根解析；systemd 模板仅允许写入默认 data 目录。
DATABASE_PATH=./data/autodl-pilot.db

# 显式持续请求的默认上限为 2 小时；截止后停止，不自动关机。
RETRY_INITIAL_INTERVAL_SEC=10
RETRY_MAX_INTERVAL_SEC=120
RETRY_BACKOFF_FACTOR=1.5
RETRY_MAX_DURATION_MINUTES=120
# 接受/不确定开机后的就绪查询窗口；超时仅停止查询，不再次盲目开机。
POLL_STATUS_INTERVAL_SEC=5
POLL_STATUS_TIMEOUT_SEC=180
LOG_LEVEL=info
