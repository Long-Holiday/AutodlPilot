[Unit]
Description=AutoDL Pilot Instance Lifecycle MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autodl-pilot
Group=autodl-pilot
WorkingDirectory=/opt/autodl-pilot
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/autodl-pilot/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/autodl-pilot/data
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
