{
  "name": "autodl-pilot-mcp",
  "version": "2.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "AutoDL GPU Instance Management Service based on MCP",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "check:shell": "for script in scripts/local/*.sh scripts/*.sh; do bash -n \"$script\" || exit 1; done",
    "test": "vitest run"
  },
  "keywords": [
    "autodl",
    "mcp",
    "model-context-protocol",
    "gpu",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
